filters:
  and:
    - file.hasTag("chapter", "scene")
formulas:
  ExportTitleOrContents: |-
    if(tags.contains("chapter"),
    "\n# Ch. " + chapter +
    ": " + title + "\n", "")
  ExportOrder: number(chapter + "." + scene)
views:
  - type: freeform
    name: Manuscript
    groupBy:
      property: book
      direction: ASC
    order:
      - formula.ExportTitleOrContents
      - file.contents
    sort:
      - property: formula.ExportOrder
        direction: ASC
    enableFileContentsEditing: false
    separator: ""
    lineSeparator: ""
    stripYamlFrontmatter: true
    stripComments: true
    trimWhitespace: true
    stripLinks: true
    showExportButton: true
    allowOverrides: true
    defaultExportFolder: Outputs
    defaultExportFile: Export.md
    exportType: markdown
    groupByCreatesSeparateOutputFiles: true
    openFileAfterExport: true
  - type: freeform
    name: Manuscript (Editable)
    groupBy:
      property: book
      direction: ASC
    order:
      - formula.ExportTitleOrContents
      - file.contents
    sort:
      - property: formula.ExportOrder
        direction: ASC
    enableFileContentsEditing: true
    separator: ""
    lineSeparator: ""
    stripYamlFrontmatter: true
    stripComments: true
    trimWhitespace: true
    stripLinks: true
    showExportButton: true
    allowOverrides: true
    defaultExportFolder: Outputs
    defaultExportFile: Export.md
    exportType: markdown
    groupByCreatesSeparateOutputFiles: true
    openFileAfterExport: true
  - type: table
    name: Table
    groupBy:
      property: book
      direction: ASC
    order:
      - file.name
      - book
      - chapter
      - scene
      - title
    sort:
      - property: formula.ExportOrder
        direction: ASC
    separator: ""
    lineSeparator: ""
    stripYamlFrontmatter: true
    stripComments: true
    trimWhitespace: true
    stripLinks: true
    showExportButton: true
    allowOverrides: true
    defaultExportFolder: Outputs
    defaultExportFile: Export.md
    exportType: markdown
    groupByCreatesSeparateOutputFiles: true
    openFileAfterExport: true
    columnSize:
      file.name: 142
